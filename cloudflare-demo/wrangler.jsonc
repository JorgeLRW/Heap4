{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "heap4-webmcp-demo",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heap4-webmcp-demo",
      "database_id": "425540ee-b188-41f4-b6e2-f25f4e73ac42"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
