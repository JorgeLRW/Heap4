{
  "name": "heap-4",
  "version": "1.0.0",
  "description": "Runtime-to-repository continuity for interrupted web workflows through native WebMCP",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --mode dev",
    "dev:cloudflare": "vite",
    "dev:server": "tsx watch server/server.ts",
    "dev:legacy": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "tsc && tsc -p worker/tsconfig.json && vite build",
    "start": "tsx server/server.ts",
    "preview": "vite preview",
    "test": "tsx test/run-tests.ts"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.13.0-next.751.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  }
}
